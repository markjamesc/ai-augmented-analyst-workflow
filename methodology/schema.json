{
  "type": "object",
  "required": [
    "version",
    "run_id",
    "question",
    "decision",
    "population",
    "grain",
    "metrics",
    "filters",
    "decision_rule",
    "claim_ceiling",
    "prior_exposure",
    "allowed_claim_types",
    "source",
    "fixtures",
    "checkpoints",
    "model",
    "invariance",
    "safeguards",
    "implementation_rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "3.0-lean"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "population": {
      "type": "string"
    },
    "grain": {
      "type": "string"
    },
    "metrics": {
      "type": "string"
    },
    "filters": {
      "type": "string"
    },
    "decision_rule": {
      "type": "string"
    },
    "claim_ceiling": {
      "type": "string"
    },
    "prior_exposure": {
      "type": "string"
    },
    "allowed_claim_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "descriptive",
          "associational",
          "predictive",
          "causal",
          "recommendation"
        ]
      },
      "minItems": 1
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "path",
        "sha256",
        "sql_applicability"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "file",
            "sql"
          ]
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "sql_applicability": {
          "type": "string",
          "enum": [
            "REQUIRED",
            "NOT_APPLICABLE"
          ]
        }
      }
    },
    "fixtures": {
      "type": "object",
      "required": [
        "manifest",
        "manifest_sha256",
        "oracle",
        "oracle_sha256"
      ],
      "properties": {
        "manifest": {
          "type": "string"
        },
        "manifest_sha256": {
          "type": "string"
        },
        "oracle": {
          "type": "string"
        },
        "oracle_sha256": {
          "type": "string"
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "keys",
          "exact_fields",
          "numeric_fields",
          "absolute_tolerance",
          "relative_tolerance",
          "numeric_missingness"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "exact_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "numeric_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "absolute_tolerance": {
            "type": "number"
          },
          "relative_tolerance": {
            "type": "number"
          },
          "numeric_missingness": {
            "type": "object"
          }
        }
      },
      "minItems": 1
    },
    "model": {
      "type": "object",
      "required": [
        "present",
        "predictions_affect_decision"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "predictions_affect_decision": {
          "type": "boolean"
        }
      }
    },
    "invariance": {
      "type": "object",
      "required": [
        "adapter",
        "relations"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "safeguards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "applies",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "applies": {
            "type": "boolean"
          },
          "why": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "implementation_rules": {
      "type": "string"
    }
  }
}
